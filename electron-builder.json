{
  "appId": "com.soheil.tradingdesksk",
  "productName": "Trading Desk Sk",
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Trading Desk Sk",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  }
}
